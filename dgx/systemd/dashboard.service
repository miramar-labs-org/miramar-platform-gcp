[Unit]
Description=kubectl proxy for Minikube dashboard (fixed port)
After=network-online.target minikube.service
Wants=minikube.service

[Service]
Type=simple
ExecStart=/usr/local/bin/kubectl --context minikube proxy --address=127.0.0.1 --port=8001
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
