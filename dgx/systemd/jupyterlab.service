[Unit]
Description=JupyterLab
After=network.target

[Service]
Type=simple
WorkingDirectory=%h
ExecStart=%h/.pyenv/versions/pyJLab/bin/jupyter lab --no-browser --ip=127.0.0.1 --port=8888 --ServerApp.token=''
Restart=on-failure
RestartSec=3
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
