[Unit]
Description=kubectl port-forward Nsight Operator gateway (8889 -> svc/nsight-operator-gateway:8888)
After=network-online.target k3s.service
Wants=network-online.target k3s.service
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
Environment=HOME=%h
Environment=KUBECONFIG=%h/.kube/config

ExecStartPre=/usr/bin/bash -lc '\
/usr/local/bin/kubectl -n nsight-operator get svc nsight-operator-gateway >/dev/null || { echo "svc/nsight-operator-gateway not found"; exit 1; }; \
for i in {1..60}; do \
  ip=$(/usr/local/bin/kubectl -n nsight-operator get endpoints nsight-operator-gateway -o jsonpath="{.subsets[0].addresses[0].ip}" 2>/dev/null || true); \
  if [ -n "$ip" ]; then exit 0; fi; \
  sleep 2; \
done; \
echo "Timed out waiting for ready endpoints for svc/nsight-operator-gateway"; \
exit 1'

ExecStart=/usr/local/bin/kubectl -n nsight-operator port-forward svc/nsight-operator-gateway 8889:8888 --address 0.0.0.0
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
