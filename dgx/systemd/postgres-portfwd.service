[Unit]
Description=kubectl port-forward Postgres (5432 -> svc/postgres)
After=network-online.target k3s.service
Wants=network-online.target k3s.service
StartLimitIntervalSec=0

[Service]
Type=simple
Environment=HOME=%h
Environment=KUBECONFIG=%h/.kube/config

# Wait until the service exists and has at least one ready endpoint
ExecStartPre=/usr/bin/bash -lc '\
/usr/local/bin/kubectl -n postgres-system get svc postgres >/dev/null || { echo "svc/postgres not found"; exit 1; }; \
for i in {1..60}; do \
  ip=$(/usr/local/bin/kubectl -n postgres-system get endpoints postgres -o jsonpath="{.subsets[0].addresses[0].ip}" 2>/dev/null || true); \
  if [ -n "$ip" ]; then exit 0; fi; \
  sleep 2; \
done; \
echo "Timed out waiting for ready endpoints for svc/postgres"; \
/usr/local/bin/kubectl -n postgres-system get endpoints postgres -o wide || true; \
exit 1'

ExecStart=/usr/local/bin/kubectl -n postgres-system port-forward svc/postgres 5432:5432 --address 0.0.0.0
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
