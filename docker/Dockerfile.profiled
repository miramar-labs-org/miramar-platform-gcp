FROM nvcr.io/nvidia/pytorch:26.04-py3

# Allow CUPTI to mount all NVIDIA driver libraries at container start.
# The NGC base image defaults to compute,utility,video which includes CUPTI, but
# setting all here ensures every profiling-related library is mounted.
ENV NVIDIA_DRIVER_CAPABILITIES=all
ENV PIP_CONSTRAINT=""
RUN pip install --no-cache-dir \
    "transformers>=4.45,<5.0" \
    "peft>=0.14" \
    accelerate \
    mlflow \
    nvtx \
    "openai>=1.40.2" \
    datasets \
    "trl>=0.14.0,<1.0"

RUN curl -fsSL \
    "https://developer.download.nvidia.com/devtools/repos/ubuntu2404/arm64/nsight-systems-cli-2026.3.1_2026.3.1.157-1_arm64.deb" \
    -o /tmp/nsight-systems-cli.deb && \
    dpkg -i /tmp/nsight-systems-cli.deb && \
    rm /tmp/nsight-systems-cli.deb
RUN ln -sf /opt/nvidia/nsight-systems-cli/2026.3.1/target-linux-sbsa-armv8/nsys /usr/local/bin/nsys

COPY nsys_*.py /usr/local/bin/
RUN chmod +x /usr/local/bin/nsys_*.py 2>/dev/null || true
