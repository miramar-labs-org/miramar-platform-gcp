FROM nvcr.io/nvidia/pytorch:26.04-py3

# Allow CUPTI to mount all NVIDIA driver libraries at container start.
# The NGC base image defaults to compute,utility,video which includes CUPTI, but
# setting all here ensures every profiling-related library is mounted.
ENV NVIDIA_DRIVER_CAPABILITIES=all
ENV PIP_CONSTRAINT=""
RUN pip install --no-cache-dir \
    "transformers>=4.45,<5.0" \
    "peft>=0.14" \
    accelerate \
    mlflow \
    nvtx \
    "openai>=1.40.2" \
    datasets \
    "trl>=0.14.0,<1.0"

COPY cuda_debian_prod.gpg /usr/share/keyrings/cuda_debian_prod.gpg
RUN printf 'Types: deb\nURIs: https://developer.download.nvidia.com/compute/cuda/repos/ubuntu2404/sbsa/\nSuites: /\nSigned-By: /usr/share/keyrings/cuda_debian_prod.gpg\n' \
        > /etc/apt/sources.list.d/cuda-compute-repo.sources && \
    apt-get update && \
    apt-get install -y nsight-systems-2026.3.1 && \
    rm -rf /var/lib/apt/lists/*
RUN ln -sf /opt/nvidia/nsight-systems-cli/2026.3.1/target-linux-sbsa-armv8/nsys /usr/local/bin/nsys

COPY nsys_*.py /usr/local/bin/
RUN chmod +x /usr/local/bin/nsys_*.py 2>/dev/null || true
