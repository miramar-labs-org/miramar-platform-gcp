# Reference unit — bootstrap.sh writes the actual unit via tee with ${USER} expanded.
[Unit]
Description=Sync SSH mesh files from DGX shared store (smbclient)
After=avahi-daemon.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# <USER> is replaced with the real username by bootstrap.sh at install time.
ExecStart=/usr/local/bin/setup-shared-ssh.sh spark-79b7.local <USER>
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
